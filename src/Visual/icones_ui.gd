const DESENHOS := {
	"fechar": [".##......##.", "..##....##..", "...##..##...", "....####....", ".....##.....", "....####....", "...##..##...", "..##....##..", ".##......##."],
	"medalha": ["..###..###..", "...######...", "....####....", "...######...", "..##....##..", ".##..##..##.", ".##.####.##.", ".##..##..##.", "..##....##..", "...######..."],
	"estrela": [".....##.....", ".....##.....", "....####....", ".##########.", "..########..", "...######...", "...######...", "..###..###..", "..##....##.."],
	"olho": ["............", "....####....", "..##....##..", ".##..##..##.", "##..####..##", ".##..##..##.", "..##....##..", "....####...."],
	"combustivel": ["...#####....", "...#...#....", "...#####.##.", "...#####..#.", "...#####..#.", "...#####..#.", "...########.", "..#######..."],
	"tempo": ["...######...", "..##....##..", ".##..#...##.", ".#...#....#.", ".#...###..#.", ".##......##.", "..##....##..", "...######..."],
	"jogar": ["..#.........", "..###.......", "..#####.....", "..#######...", "..#########.", "..#######...", "..#####.....", "..###.......", "..#........."],
	"pausa": ["..###..###..", "..###..###..", "..###..###..", "..###..###..", "..###..###..", "..###..###..", "..###..###..", "..###..###.."],
	"config": ["....####....", "..########..", ".###....###.", ".##..##..##.", "###.####.###", "###.####.###", ".##..##..##.", ".###....###.", "..########..", "....####...."],
	"info": ["....####....", "....####....", "............", "....####....", "......##....", "......##....", "......##....", "....######.."],
	"voltar": [".....##.....", "....##......", "...##.......", "..#########.", ".##########.", "..#########.", "...##.......", "....##......", ".....##....."],
	"cadeado": ["....####....", "...##..##...", "...##..##...", "...##..##...", "..########..", "..########..", "..###..###..", "..###..###..", "..########.."],
	"concluida": ["..........##", ".........##.", "........##..", ".##....##...", "..##..##....", "...####.....", "....##......"],
	"reiniciar": ["..######....", ".##....###..", "##.......##.", "##.......##.", "##.....#####", "##......###.", "##.......#..", ".##.........", "..##....##..", "...######..."],
	"mapa": [".###.###.###", ".#.#.#.#.#.#", ".#.#.#.#.#.#", ".#.#.#.#.#.#", ".#.#.#.#.#.#", ".#.#.#.#.#.#", ".###.###.###"],
	"alvo": [".....##.....", "...######...", "..##....##..", ".##..##..##.", "###.####.###", "###.####.###", ".##..##..##.", "..##....##..", "...######...", ".....##....."],
	"fases": [".####..####.", ".####..####.", ".####..####.", "............", ".####..####.", ".####..####.", ".####..####."],
	"casa": [".....##.....", "....####....", "...######...", "..########..", ".##########.", "..##....##..", "..##.##.##..", "..##.##.##..", "..########.."]
}
static var _cache: Dictionary = {}

static func obter(nome: String) -> Texture2D:
	if _cache.has(nome):
		return _cache[nome]
	var imagem := Image.create(12, 12, false, Image.FORMAT_RGBA8)
	imagem.fill(Color.TRANSPARENT)
	var linhas: Array = DESENHOS.get(nome, DESENHOS.info)
	for y in linhas.size():
		for x in mini(linhas[y].length(), 12):
			if linhas[y][x] == "#":
				imagem.set_pixel(x, y + 1, Color.WHITE)
	var textura := ImageTexture.create_from_image(imagem)
	_cache[nome] = textura
	return textura

static func aplicar(botao: Button, nome: String, descricao: String, so_icone := true) -> void:
	botao.icon = obter(nome)
	botao.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	botao.tooltip_text = descricao
	botao.accessibility_name = descricao
	if so_icone:
		botao.text = ""
		botao.alignment = HORIZONTAL_ALIGNMENT_CENTER
		botao.icon_alignment = HORIZONTAL_ALIGNMENT_CENTER
		botao.expand_icon = false
		botao.custom_minimum_size = Vector2(28, 28)
		botao.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
		botao.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	botao.custom_minimum_size.x = maxf(botao.custom_minimum_size.x, 28)
